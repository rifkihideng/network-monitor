# Turso (libsql)
TURSO_DATABASE_URL=libsql://nama-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Monitoring otomatis
MONITOR_HOST=1.1.1.1
MONITOR_INTERVAL_MS=300000
MONITOR_ENABLED=true
# Dipakai Vercel Cron untuk memproteksi /api/monitor
CRON_SECRET=change-me

# GitHub OAuth (login) — daftar OAuth App di https://github.com/settings/developers
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
AUTH_SECRET=change-me-to-a-long-random-string
# Opsional: override redirect URI (default: <origin>/api/auth/callback)
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback
